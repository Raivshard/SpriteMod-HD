{
  "$schema": "./MenuLayout_schema.json",
  "_HELP": "All options and examples: MenuLayout_README.md (same folder). Units = px at 1440p. Saves apply live.",
  "_________________________": "",
  "_                       _": "",
  "_        GENERAL        _": "",
  "_________________________": "",
  "log": false,
  "perf": false,
  "profileGame": false,
  "cleanup": { "skipGcCollect": true, "unloadEveryMinutes": 10 },
  "kupoTextureCache": true,
  "fieldSprites": true,
  "fieldScale": 1.4,
  "fieldStrideDelay": { "WalkL": [0.1, 0.02, 0.1], "Default": [0.1, 0.02, 0.1], "WalkB": [0.1, 0.02, 0.1] },
  "fieldCeilingSigns": { "map_chip_147": [[0, 320], [16, 320], [32, 320], [0, 336], [16, 336], [32, 336]] },
  "fieldSpritesDebug": false,
  "kupoFastUnreadable": true,
  "characterNames": {},
  "________________________________________________________": "",
  "_                                                      _": "",
  "_        FONT TYPES (every text of a font type)        _": "",
  "________________________________________________________": "",
  "textStyles": [
    { "fontType": ["Font08", "Font09", "Font10"],
      "fontStyle": "Small"
    }
  ],
  "____________________________________________": "",
  "_                                          _": "",
  "_        CHARACTER SPRITES IN MENUS        _": "",
  "____________________________________________": "",
  "screens": [
    { "name": "main menu",
      "match": "status_info_content",
      "height": 240,
      "moveDown": 34,
      "moveRight": 0
    },
    { "name": "load/save rows",
      "match": "Content/save_slot(Clone)",
      "height": 304,
      "moveDown": 4,
      "moveRight": 0
    },
    { "name": "status",
      "match": "status_details",
      "height": 304,
      "moveDown": 54,
      "moveRight": -178,
      "hide": [{ "path": "status_details(Clone)/character_info/line/", "sprite": "UI_Common_WhiteLine01" }]
    },
    { "name": "magic",
      "match": "ability_info",
      "height": 198,
      "moveDown": 41,
      "moveRight": 0
    },
    { "name": "equip select",
      "_comment": "Must stay above 'equip' (first match wins).",
      "match": "select_info/charactor_info",
      "height": 300,
      "top": 398,
      "moveRight": 0
    },
    { "name": "equip",
      "match": "equipment_info",
      "height": 368,
      "top": 330,
      "moveRight": 0
    }
  ],
  "_____________________________________________________": "",
  "_                                                   _": "",
  "_        BATTLE SCREEN (cameras, background)        _": "",
  "_____________________________________________________": "",
  "battle": { "resolutionScale": 0, "fitBackground": true, "spritesDown": 170, "customScale": 1.6, "enemyOnTop": ["MN_FF5_127"], "partyRight": 0, "partyDown": 0, "partySlots": [[-240, 90], [-120, 60], [0, 30], [120, 0]], "backRowShift": 248, "depthScale": 90, "groundShadow": { "on": true, "debug": false, "azimuth": 45, "elevation": 60, "opacity": 0.75, "groundTilt": 0.5, "hideGameShadows": false, "thickness": 0.15, "depthRange": 0.6, "blur": 4, "falloff": 0.75 } },
  "renderHeights": { "CameraBattle": 1440, "CameraBattlebackGround": 1707, "CameraFieldMain": 1440, "CameraTileMap": 1440 },
  "__________________________________________________": "",
  "_                                                _": "",
  "_        LOADING ICON AND TITLE HIGHLIGHT        _": "",
  "__________________________________________________": "",
  "loadingIcon": { "frameTime": 0.125, "size": 256, "priority": "BelowNormal" },
  "titleHighlight": { "color": "#FFE08A", "scale": 1.1, "fadeTime": 0.15 },
  "_______________________________": "",
  "_                             _": "",
  "_        SHARED STYLES        _": "",
  "_______________________________": "",
  "styles": {
    "screen name": {
      "color": "#6FFFAF",
      "font": "Amarante",
      "fontScale": 1.25
    },
    "list row": {
      "font": "SpriteMod Sans Light",
      "fontScale": 1.0,
      "selected": {
        "color": "#33FF66",
        "font": "SpriteMod Sans"
      },
      "greyed": {
        "color": "#999999"
      }
    }
  },
  "__________________________________________________________": "",
  "_                                                        _": "",
  "_     ELEMENTS: texts and images, grouped by screen      _": "",
  "__________________________________________________________": "",
  "elements": [
    { "___ T I T L E   S C R E E N ___": "",
      "_                            _": "",
      "_        TITLE SCREEN        _": "",
      "______________________________": ""
    },
    { "name": "title menu spacing",
      "path": "content_root/menu/main_menu",
      "spacing": 20
    },
    { "name": "title logo",
      "path": "content_root/title_image",
      "moveDown": 40
    },
    { "name": "title menu font",
      "path": "main_menu/title_command_content(Clone)/last_text",
