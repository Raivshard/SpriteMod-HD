      "fontSize": 45.3,
      "shadow": { "color": "#000000C0", "distance": 4, "blur": 2 }
    },
    { "name": "title Extras menu font",
      "path": "sub_menu/title_command_content(Clone)/last_text",
      "font": "Amarante",
      "fontSize": 45.3,
      "shadow": { "color": "#000000C0", "distance": [4] }
